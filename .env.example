# Copy to .env.local and fill in real values. Never commit .env.local.

# --- Supabase ---------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Database password connection string (Supabase -> Connect -> Direct connection).
DATABASE_URL=
# The direct host is IPv6-only; db scripts reroute through this session pooler
# host when set. Not a secret. Example: aws-0-ap-southeast-1.pooler.supabase.com
SUPABASE_POOLER_HOST=

# --- AI / speech-to-text ------------------------------------------------------
ANTHROPIC_API_KEY=
# Optional override of the Claude model id (defaults to claude-opus-5).
ANTHROPIC_MODEL=
ELEVENLABS_API_KEY=
ELEVENLABS_WEBHOOK_SECRET=
ASSEMBLYAI_API_KEY=
ASSEMBLYAI_WEBHOOK_SECRET=

# --- Email (meeting invitations) -----------------------------------------------
# Brevo transactional email API key. Leave empty to skip sending email.
BREVO_API_KEY=
# Sender shown on invitations, e.g. "ZPPSU SmartMin <no-reply@zppsu.edu.ph>".
MAIL_FROM=

NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Demo accounts (used by scripts/seed-*.mjs and the verify scripts) ---------
# Never commit real values. Rotate them on the live project if they leak.
DEMO_PASSWORD_ADMIN=
DEMO_PASSWORD_HEAD=
DEMO_PASSWORD_SECRETARY=
DEMO_PASSWORD_FACULTY=
# Set to 1 to show email quick-fill buttons on the login page (no passwords).
NEXT_PUBLIC_DEMO_LOGINS=
