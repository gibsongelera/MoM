{
  "name": "smartmin",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src scripts",
    "types": "tsc --noEmit",
    "test": "vitest run",
    "db:push": "node --env-file=.env.local scripts/db-push.mjs",
    "db:seed": "node --env-file=.env.local scripts/seed-demo.mjs",
    "db:seed-users-only": "node --env-file=.env.local scripts/seed-users-only.mjs",
    "db:reset": "node --env-file=.env.local scripts/seed-demo.mjs --reset",
    "db:verify": "node --env-file=.env.local scripts/verify-rls-sql.mjs",
    "db:verify:pending": "node --env-file=.env.local scripts/verify-rls-sql.mjs --with-pending",
    "db:verify:live": "node --env-file=.env.local scripts/verify-rls.mjs && node --env-file=.env.local scripts/verify-amend.mjs",
    "db:backup": "node --env-file=.env.local scripts/db-backup.mjs",
    "db:seed:scenario": "node --env-file=.env.local scripts/seed-scenario.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@react-pdf/renderer": "^4.9.0",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.111.0",
    "chart.js": "^4.5.1",
    "docx": "^9.8.1",
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "pg": "^8.22.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "description": "ZPPSU SmartMin - AI-assisted institutional governance platform",
  "browserslist": [
    "chrome >= 111",
    "edge >= 111",
    "firefox >= 128",
    "safari >= 16.4"
  ]
}
